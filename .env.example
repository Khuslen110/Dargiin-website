# ─── Backend ───────────────────────────────────────────────────────────────
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/people_registry
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/people_registry_test
# Урт, санамсаргүй утга (жишээ: python -c "import secrets;print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me-to-a-long-random-value
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=8
COOKIE_DOMAIN=
# Dev seed-д л ашиглана. Production-д хоосон орхиж CLI-аар нууц үг үүсгэнэ.
ADMIN_INITIAL_PASSWORD=

# ─── Frontend ──────────────────────────────────────────────────────────────
# Хоосон бол Vite /api-г http://localhost:8000 руу proxy хийнэ.
VITE_API_URL=
